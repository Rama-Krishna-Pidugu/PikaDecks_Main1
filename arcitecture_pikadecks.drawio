        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam backgroundColor #FFFFFF\nskinparam packageStyle rectangle\nskinparam shadowing false\n\npackage \&quot;Domain &amp; Routing\&quot; as DomainPackage {\n    component \&quot;Cloudflare DNS\\n(pikadecks.app)\&quot; as DNS\n    component \&quot;Cloudflare Tunnel\&quot; as Tunnel\n}\n\npackage \&quot;User Interface &amp; Auth\&quot; as UIPackage {\n    component \&quot;Vercel Web Server\&quot; as Vercel\n    component \&quot;Clerk JWT Authentication\&quot; as Clerk\n}\n\npackage \&quot;External Integrations\&quot; as ExtPackage {\n    component \&quot;Razorpay Subscription\&quot; as Razorpay\n    component \&quot;Google Play Console\&quot; as GooglePlay\n    component \&quot;Firebase Cloud (FCM)\&quot; as FCM\n    component \&quot;AI (Groq &amp; Gemini)\&quot; as AI\n}\n\npackage \&quot;AWS Cloud Platform\&quot; as AWSPackage {\n    component \&quot;FastAPI API Gateway\&quot; as APIGateway\n    component \&quot;FastAPI Lambda\&quot; as LambdaAPI\n    component \&quot;SSM Parameter Store\&quot; as SSM\n    component \&quot;S3 (pikadecks-pdfs)\&quot; as S3\n    \n    component \&quot;AWS EventBridge\&quot; as EventBridge\n    \n    package \&quot;Cron / Scheduled Lambdas\&quot; as CronLambdas {\n        component \&quot;Notification Service\&quot; as Worker_Notification\n        component \&quot;Stale Job Sweeper\&quot; as Worker_Sweeper\n        component \&quot;Provider Health Check\&quot; as Worker_Health\n    }\n    \n    package \&quot;SQS Messaging Pipeline\&quot; as SQSPackage {\n        queue \&quot;Upload SQS\&quot; as SQS_Upload\n        queue \&quot;Gemini SQS\&quot; as SQS_Gemini\n        queue \&quot;Groq SQS\&quot; as SQS_Groq\n        queue \&quot;Reduce SQS\&quot; as SQS_Reduce\n        queue \&quot;YouTube SQS\&quot; as SQS_YouTube\n    }\n    \n    package \&quot;AWS Lambda Workers\&quot; as WorkersPackage {\n        component \&quot;Orchestrator\&quot; as Worker_Orchestrator\n        component \&quot;Gemini Worker\&quot; as Worker_Gemini\n        component \&quot;Groq Worker\&quot; as Worker_Groq\n        component \&quot;Reducer Worker\&quot; as Worker_Reducer\n        component \&quot;YouTube Worker\&quot; as Worker_YouTube\n    }\n}\n\npackage \&quot;Primary Storage\&quot; as DbPackage {\n    database \&quot;Supabase Postgres\&quot; as Supabase\n}\n\n&#39; Layout alignment hints\nDomainPackage -down-&gt; UIPackage\nUIPackage -down-&gt; AWSPackage\nAWSPackage -down-&gt; DbPackage\nExtPackage -left-&gt; AWSPackage\n\n&#39; Routing (Orange)\nDNS -[#D97706]down-&gt; Vercel : \&quot;Route Web\&quot;\nDNS -[#D97706]down-&gt; APIGateway : \&quot;Route API\&quot;\nDNS -[#D97706]down-&gt; Tunnel : \&quot;Route MCP\&quot;\n\n&#39; API Gateway &amp; Auth (Orange)\nAPIGateway -[#D97706]down-&gt; LambdaAPI : \&quot;Invoke\&quot;\nLambdaAPI -[#D97706]right-&gt; Clerk : \&quot;Validate tokens\&quot;\n\n&#39; Database operations (Green)\nLambdaAPI -[#16A34A]down-&gt; Supabase : \&quot;SQL Ops\&quot;\nWorker_Notification -[#16A34A]down-&gt; Supabase : \&quot;Select notifications\&quot;\nWorker_Sweeper -[#16A34A]down-&gt; Supabase : \&quot;Clean stale jobs\&quot;\nWorker_Gemini -[#16A34A]down-&gt; Supabase : \&quot;Insert chunks\&quot;\nWorker_Groq -[#16A34A]down-&gt; Supabase : \&quot;Insert chunks\&quot;\nWorker_Reducer -[#16A34A]down-&gt; Supabase : \&quot;Deduplicate &amp; Save\&quot;\nWorker_YouTube -[#16A34A]down-&gt; Supabase : \&quot;Save deck\&quot;\n\n&#39; S3 &amp; Secrets (Gray)\nLambdaAPI -[#6B7280]down-&gt; S3 : \&quot;S3 Presigned URLs\&quot;\nWorker_Health -[#6B7280]up-&gt; SSM : \&quot;Update state\&quot;\n\n&#39; SQS Pipeline &amp; AI Generation (Blue)\nLambdaAPI -[#2563EB]down-&gt; SQS_Upload : \&quot;Enqueue PDF\&quot;\nLambdaAPI -[#2563EB]down-&gt; SQS_YouTube : \&quot;Enqueue YouTube\&quot;\n\nSQS_Upload -[#2563EB]down-&gt; Worker_Orchestrator : \&quot;Dequeue\&quot;\nWorker_Orchestrator -[#2563EB]up-&gt; S3 : \&quot;Download PDF\&quot;\nWorker_Orchestrator -[#2563EB]down-&gt; SQS_Gemini : \&quot;Dispatch chunk\&quot;\nWorker_Orchestrator -[#2563EB]down-&gt; SQS_Groq : \&quot;Dispatch chunk\&quot;\n\nSQS_Gemini -[#2563EB]down-&gt; Worker_Gemini : \&quot;Dequeue\&quot;\nWorker_Gemini -[#2563EB]right-&gt; AI : \&quot;API Call\&quot;\nWorker_Gemini -[#2563EB]down-&gt; SQS_Reduce : \&quot;Enqueue\&quot;\n\nSQS_Groq -[#2563EB]down-&gt; Worker_Groq : \&quot;Dequeue\&quot;\nWorker_Groq -[#2563EB]right-&gt; AI : \&quot;API Call\&quot;\nWorker_Groq -[#2563EB]down-&gt; SQS_Reduce : \&quot;Enqueue\&quot;\n\nSQS_Reduce -[#2563EB]down-&gt; Worker_Reducer : \&quot;Dequeue\&quot;\nSQS_YouTube -[#2563EB]down-&gt; Worker_YouTube : \&quot;Dequeue\&quot;\nWorker_YouTube -[#2563EB]right-&gt; AI : \&quot;API Call\&quot;\n\n&#39; EventBridge &amp; Push Notifications (Purple)\nEventBridge -[#7C3AED]down-&gt; Worker_Notification : \&quot;Schedule trigger\&quot;\nEventBridge -[#7C3AED]down-&gt; Worker_Sweeper : \&quot;Schedule trigger\&quot;\nEventBridge -[#7C3AED]down-&gt; Worker_Health : \&quot;Schedule trigger\&quot;\nWorker_Notification -[#7C3AED]right-&gt; FCM : \&quot;Send push notifications\&quot;\nWorker_Reducer -[#7C3AED]right-&gt; FCM : \&quot;Success Push\&quot;\nWorker_Health -[#7C3AED]right-&gt; AI : \&quot;Ping models\&quot;\n\n&#39; Billing &amp; Payments (Red)\nLambdaAPI &lt;-[#DC2626]left- Razorpay : \&quot;Webhooks\&quot;\nLambdaAPI &lt;-[#DC2626]left- GooglePlay : \&quot;RTDN Updates\&quot;\n@enduml\n\n&quot;,&quot;format&quot;:&quot;svg&quot;}" id="UE543g0Di1ziarH-sJJI-1">
