{
  "cli": {
    "version": ">= 19.0.8",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_API_URL": "https://zxd2zncyzh.execute-api.ap-south-1.amazonaws.com",
        "EXPO_PUBLIC_ENABLE_BILLING": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview",
        "EXPO_PUBLIC_API_URL": "https://zxd2zncyzh.execute-api.ap-south-1.amazonaws.com",
        "EXPO_PUBLIC_ENABLE_BILLING": "true",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "internal-testing",
        "EXPO_PUBLIC_API_URL": "https://zxd2zncyzh.execute-api.ap-south-1.amazonaws.com",
        "EXPO_PUBLIC_ENABLE_BILLING": "true",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      }
    }
  }
}
